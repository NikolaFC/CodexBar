<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CodexBar.Windows</RootNamespace>
    <AssemblyName>CodexBar.Windows</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0</InformationalVersion>
    <Product>CodexBar</Product>
    <Company>CodexBar</Company>
    <Description>CodexBar Windows tray app for Codex and Claude usage.</Description>
    <NeutralLanguage>zh-Hans</NeutralLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- The DPI-aware manifest is required for WPF; the WinForms analyzer prefers its own API. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodexBar.Core\CodexBar.Core.csproj" />
  </ItemGroup>

  <!--
    Implicit usings are disabled because UseWindowsForms would add globals for
    System.Windows.Forms and System.Drawing, and WPF defines conflicting
    Application, Brush, TextBox, and KeyEventArgs types. GlobalUsings.cs lists
    the framework namespaces this project actually wants; files that need
    WinForms or GDI+ import them explicitly, through an alias where they clash.
  -->

</Project>
