<Window x:Class="CodexBar.Windows.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:CodexBar.Windows.Views"
        Title="CodexBar"
        Width="480"
        Height="680"
        MinWidth="420"
        MinHeight="520"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <local:StringToVisibilityConverter x:Key="StringToVisibility" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:InverseBooleanConverter x:Key="InverseBool" />

        <Style x:Key="CardActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SegmentBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrongBorderBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource HoverSurfaceBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsProminent}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentCodexBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentCodexBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="WindowRowTemplate">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" MinWidth="86" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{Binding Name}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="12.5"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <ProgressBar Grid.Row="0" Grid.Column="1"
                             Style="{StaticResource QuotaBar}"
                             Value="{Binding BarPercent, Mode=OneWay}"
                             Foreground="{Binding BarBrush}"
                             Margin="0,0,10,0"
                             VerticalAlignment="Center" />

                <TextBlock Grid.Row="0" Grid.Column="2"
                           Text="{Binding PercentText}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                           Text="{Binding DetailText}"
                           Style="{StaticResource HintText}"
                           Margin="0,4,0,0" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ProviderCardTemplate">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,8,0"
                                 Fill="{Binding AccentBrush}" VerticalAlignment="Center" />

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Title}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />

                        <Border Grid.Column="2" Style="{StaticResource ChipBorder}" Margin="8,0,0,0"
                                Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource ChipText}" Text="{Binding Plan}" />
                        </Border>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Margin="0,0,6,0"
                                     Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusText}"
                                       FontSize="11.5"
                                       Foreground="{Binding StatusBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="{Binding PrimaryPercentText}"
                                       FontSize="28"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Bottom" />
                            <TextBlock Text="{Binding PrimaryCaption}"
                                       FontSize="11.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="8,0,0,6"
                                       VerticalAlignment="Bottom" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,4">
                            <TextBlock Text="{Binding FreshnessText}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding SourceText}"
                                       Style="{StaticResource HintText}"
                                       HorizontalAlignment="Right"
                                       Visibility="{Binding SourceText, Converter={StaticResource StringToVisibility}}" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl Margin="0,12,0,0"
                                  ItemTemplate="{StaticResource WindowRowTemplate}"
                                  ItemsSource="{Binding Windows}"
                                  Visibility="{Binding HasWindows, Converter={StaticResource BoolToVisibility}}" />

                    <Border Margin="0,4,0,0" Padding="10,8" CornerRadius="6"
                            Background="{StaticResource InsetBackgroundBrush}"
                            BorderBrush="{StaticResource StrongBorderBrush}"
                            BorderThickness="1"
                            Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Message}"
                                   TextWrapping="Wrap"
                                   FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>

                    <ItemsControl Margin="0,10,0,-6" ItemsSource="{Binding Actions}"
                                  Visibility="{Binding HasActions, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource CardActionButton}"
                                        Content="{Binding Text}"
                                        Command="{Binding Command}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="WindowSurface"
            Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1">
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Margin="14,10,10,6" Background="Transparent"
                  MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="CodexBar"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                    <Border Style="{StaticResource ChipBorder}" Margin="8,0,0,0">
                        <TextBlock Style="{StaticResource ChipText}" Text="{Binding VersionText, StringFormat=v{0}}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Command="{Binding RefreshCommand}"
                            ToolTip="{Binding RefreshButtonTooltip}" Focusable="False">
                        <Path Style="{StaticResource IconGeometry}"
                              Data="M13.5 6.5 A5.5 5.5 0 1 1 10.8 2.3 M13.5 2.6 L13.5 6.6 L9.5 6.6" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding OpenSettingsCommand}"
                            ToolTip="设置" Focusable="False">
                        <Path Style="{StaticResource IconGeometry}"
                              Data="M10 6.4 L10 13.6 M6.4 10 L13.6 10 M10 13.2 A3.2 3.2 0 1 0 10 6.8 A3.2 3.2 0 1 0 10 13.2" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding HideCommand}"
                            ToolTip="隐藏到系统托盘 (Esc)" Focusable="False">
                        <Path Style="{StaticResource IconGeometry}" Data="M5 10 L15 10" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Demo banner -->
            <Border Grid.Row="1" Margin="14,4,14,0" Padding="10,7" CornerRadius="6"
                    Background="{StaticResource DemoBannerBrush}"
                    BorderBrush="{StaticResource DemoBannerBorderBrush}"
                    BorderThickness="1"
                    Visibility="{Binding IsDemo, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="演示模式 DEMO · 以下为示例数据，不是你的真实额度"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource AccentWarnBrush}" />
            </Border>

            <!-- Mode switch -->
            <Grid Grid.Row="2" Margin="14,10,14,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="额度总览" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding StatusLine}" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                </StackPanel>

                <Border Grid.Column="1" Background="{StaticResource SegmentBackgroundBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="7" Padding="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton Style="{StaticResource SegmentToggle}" Content="剩余"
                                      IsChecked="{Binding IsRemainingMode, Mode=OneWay}"
                                      Command="{Binding SetRemainingModeCommand}" Focusable="False" />
                        <ToggleButton Style="{StaticResource SegmentToggle}" Content="已用"
                                      IsChecked="{Binding IsUsedMode, Mode=OneWay}"
                                      Command="{Binding SetUsedModeCommand}" Focusable="False" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Cards -->
            <ScrollViewer Grid.Row="3" Style="{StaticResource SlimScrollViewer}"
                          Margin="14,0,8,0" Padding="0,0,6,0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource ProviderCardTemplate}" />
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="4" Margin="0,10,0,0" Padding="14,9"
                    Background="{StaticResource InsetBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StatusLine}" Style="{StaticResource HintText}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                            Content="设置" Command="{Binding OpenSettingsCommand}" Focusable="False"
                            Padding="10,4" Margin="8,0,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
