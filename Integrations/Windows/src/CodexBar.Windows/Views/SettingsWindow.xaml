<Window x:Class="CodexBar.Windows.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CodexBar 设置"
        Width="520"
        Height="620"
        MinWidth="460"
        MinHeight="520"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="WindowSurface"
            Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1">
        <Grid x:Name="SettingsRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="18,14,12,10" Background="Transparent"
                  MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="设置" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Style="{StaticResource IconButton}" Click="OnCancelClick"
                        ToolTip="关闭 (Esc)" Focusable="False">
                    <Path Style="{StaticResource IconGeometry}" Data="M6 6 L14 14 M14 6 L6 14" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" Style="{StaticResource SlimScrollViewer}" Margin="18,0,12,0"
                          Padding="0,0,6,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="服务" Margin="0,0,0,10" />
                            <CheckBox x:Name="CodexEnabledBox" Style="{StaticResource DarkCheckBox}"
                                      Content="启用 Codex 额度" />
                            <CheckBox x:Name="ClaudeEnabledBox" Style="{StaticResource DarkCheckBox}"
                                      Content="启用 Claude 额度" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="刷新频率" Margin="0,0,0,10" />
                            <ComboBox x:Name="RefreshIntervalBox"
                                      Style="{StaticResource DarkComboBox}" />
                            <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                                       Text="刷新时两个服务并行请求，上一次请求未完成时会跳过本轮。" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="凭据文件" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="CodexBar 只读取本机 CLI 已保存的凭据，不会刷新或写入令牌。留空则自动发现默认位置。" />

                            <TextBlock Text="Codex 凭据 (auth.json)" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CodexPathBox" Grid.Column="0" Style="{StaticResource DarkTextBox}" />
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="浏览…"
                                        Margin="8,0,0,0" Click="OnBrowseCodexClick" Focusable="False" />
                            </Grid>
                            <TextBlock x:Name="CodexPathHint" Style="{StaticResource HintText}" Margin="0,6,0,0" />

                            <TextBlock Text="Claude 凭据 (.credentials.json)" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,14,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ClaudePathBox" Grid.Column="0" Style="{StaticResource DarkTextBox}" />
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="浏览…"
                                        Margin="8,0,0,0" Click="OnBrowseClaudeClick" Focusable="False" />
                            </Grid>
                            <TextBlock x:Name="ClaudePathHint" Style="{StaticResource HintText}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,4">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="提醒与启动" Margin="0,0,0,10" />
                            <CheckBox x:Name="NotifyLowQuotaBox" Style="{StaticResource DarkCheckBox}"
                                      Content="额度已用超过 90% 时提醒" />
                            <CheckBox x:Name="StartWithWindowsBox" Style="{StaticResource DarkCheckBox}"
                                      Content="登录 Windows 时自动启动（后台常驻托盘）" Margin="0,10,0,0" />
                            <TextBlock x:Name="DemoHint" Style="{StaticResource HintText}" Margin="0,10,0,0"
                                       Visibility="Collapsed"
                                       Text="演示模式：设置只在内存中生效，不会写入注册表或配置文件。" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Margin="0,12,0,0" Padding="18,12"
                    Background="{StaticResource InsetBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Grid.Column="0" Style="{StaticResource HintText}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="取消"
                            Click="OnCancelClick" Margin="0,0,8,0" Focusable="False" />
                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="保存"
                            Click="OnSaveClick" Focusable="False" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
